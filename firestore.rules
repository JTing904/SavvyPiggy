rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Membership is a document, so it cannot be faked from the client.
    function isMember(uid) {
      return exists(/databases/$(database)/documents/members/$(uid));
    }

    // The one account that may mint invites from inside the app. The email
    // must be the verified one on the sign-in token (Google sign-in is), so
    // nobody can become the admin by typing this address into a sign-up form.
    function isAdmin() {
      return signedIn()
          && request.auth.token.get('email_verified', false) == true
          && request.auth.token.get('email', '') == 'kengtingtan@gmail.com'
          && isMember(request.auth.uid);
    }

    // One-time invite codes; the document ID *is* the code. Hand-made ones in
    // the console (no expiresAt) still work and never expire. Ones minted in
    // the app carry an expiry, and the server refuses a claim after it.
    // Claiming stamps the claimer's uid on it, and the null check makes that a
    // one-way door.
    match /invites/{code} {
      allow get: if signedIn();

      // Only the admin, only a well-formed code, only valid for a short while.
      allow create: if isAdmin()
                    && code.matches('SAVVY-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}')
                    && request.resource.data.keys().hasOnly(['createdBy', 'createdAt', 'expiresAt'])
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.time
                    && request.resource.data.expiresAt <= request.time + duration.value(11, 'm');

      // Claiming also has to grant membership in the same write, so a code
      // cannot be burned by someone who never joins, and has to be in date.
      allow update: if signedIn()
                    && resource.data.get('claimedBy', null) == null
                    && (resource.data.get('expiresAt', null) == null
                        || resource.data.expiresAt > request.time)
                    && request.resource.data.claimedBy == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['claimedBy', 'claimedAt'])
                    && existsAfter(/databases/$(database)/documents/members/$(request.auth.uid));

      // The admin may withdraw an unused code of their own (making a new one
      // does this to the last). Never listing, never anyone else's.
      allow delete: if isAdmin()
                    && resource.data.get('createdBy', null) == request.auth.uid
                    && resource.data.get('claimedBy', null) == null;

      allow list: if false;
    }

    // Proof of membership. Creatable only inside the same batched write that
    // claims an unclaimed invite — getAfter() sees that write's result, so a
    // member document can never exist without a code having been burned.
    match /members/{uid} {
      allow get: if isOwner(uid);

      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(['code', 'joinedAt'])
                    && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.code))
                         .data.get('claimedBy', null) == request.auth.uid;

      allow list, update, delete: if false;
    }

    // The investment pot is cash, and cash cannot be spent twice. A phone that
    // was offline can queue a buy against a balance another phone has already
    // spent; the server is the only place that sees both, so it refuses any
    // write that leaves the pot below zero. The small allowance absorbs float
    // increments (100.1 - 100.1 can land on -2.8e-17), and a pot that is
    // already negative may still be saved as long as it does not go lower, so
    // the rest of the investing settings never get stuck behind it.
    function potStaysNonNegative() {
      let after = request.resource.data;
      return !('potBalance' in after)
        || (after.potBalance is number
            && (after.potBalance >= -0.001
                || (resource != null && after.potBalance >= resource.data.get('potBalance', 0))));
    }

    // A user's own data, gated on membership. Without a redeemed invite the
    // account exists but can read and write nothing at all.
    match /users/{uid} {
      allow read, write: if isOwner(uid) && isMember(uid);

      // Rules are OR'd, so a wildcard that also matched settings/invest would
      // let any write through and the pot guard below would never bite. This
      // one covers every top-level document except that one.
      match /{collectionId}/{docId} {
        allow read: if isOwner(uid) && isMember(uid);
        allow write: if isOwner(uid) && isMember(uid)
                     && !(collectionId == 'settings' && docId == 'invest');
      }

      // Anything nested deeper under a document. At least one more segment is
      // required, because {rest=**} alone also matches zero segments.
      match /{collectionId}/{docId}/{subCollectionId}/{rest=**} {
        allow read, write: if isOwner(uid) && isMember(uid);
      }

      match /settings/invest {
        allow read, delete: if isOwner(uid) && isMember(uid);
        allow create, update: if isOwner(uid) && isMember(uid) && potStaysNonNegative();
      }
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
