# Copy this file to .env.local and paste the values from
# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
# These keys are public by design; access is controlled by firestore.rules / storage.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to run against the local Firebase emulators instead of the cloud.
VITE_USE_FIREBASE_EMULATOR=false

# Cloud Storage needs the Blaze plan. Leave false to hide goal image uploads.
VITE_ENABLE_STORAGE=false
